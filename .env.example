# Salin file ini menjadi .env lalu isi sesuai database di hosting Anda.
DB_HOST=localhost
DB_PORT=3306
DB_USER=nama_user_database
DB_PASSWORD=password_database
DB_NAME=nama_database

# Port aplikasi (di cPanel biasanya diatur otomatis, boleh dikosongkan)
PORT=3000

# Lama sesi login guru (hari)
SESSION_DAYS=30
